    "                8,\n",
    "                12\n",
    "            ),\n",
    "            \"C4_beta\": band_power(\n",
    "                epoch[\"C4\"].values,\n",
    "                FS,\n",
    "                13,\n",
    "                30\n",
    "            ),\n",
    "        }\n",
    "\n",
    "        window_records.append(record)\n",
    "\n",
    "\n",
    "window_features = pd.DataFrame(window_records)"
