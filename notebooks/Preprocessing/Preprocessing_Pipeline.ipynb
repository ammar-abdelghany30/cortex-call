   "source": [
    "from scipy.stats import ttest_ind\n",
    "\n",
    "results = []\n",
    "\n",
    "for window in window_features[\"window\"].unique():\n",
    "\n",
    "    temp = window_features[\n",
    "        window_features[\"window\"] == window\n",
    "    ]\n",
    "\n",
    "    for feature in [\n",
    "        \"C3_mu\",\n",
    "        \"C3_beta\",\n",
    "        \"C4_mu\",\n",
    "        \"C4_beta\"\n",
    "    ]:\n",
    "\n",
    "        left = temp[\n",
    "            temp[\"label\"] == \"left\"\n",
    "        ][feature]\n",
    "\n",
    "        right = temp[\n",
    "            temp[\"label\"] == \"right\"\n",
    "        ][feature]\n",
    "\n",
    "        t_stat, p_value = ttest_ind(\n",
    "            left,\n",
    "            right,\n",
    "            equal_var=False\n",
    "        )\n",
    "\n",
    "        results.append({\n",
    "            \"window\": window,\n",
    "            \"feature\": feature,\n",
    "            \"t_stat\": t_stat,\n",
    "            \"p_value\": p_value\n",
    "        })\n",
    "\n",
    "\n",
    "window_stats = pd.DataFrame(results)\n",
    "\n",
    "display(window_stats)"
   ]
  },
